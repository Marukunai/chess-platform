# ---- Base de datos ----
POSTGRES_DB=chess_platform
POSTGRES_USER=chess_admin
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_PORT=5432

# ---- Backend / Spring ----
SPRING_PROFILES_ACTIVE=docker
SERVER_PORT=8080

# ---- JWT ----
# Genera uno propio en local, por ejemplo con: openssl rand -base64 48
JWT_SECRET=changeme_generate_a_long_random_secret
JWT_EXPIRATION_MS=86400000

# ---- Búsqueda de GIFs en el chat ----
# Gratis en https://developers.giphy.com — sin esta clave, el buscador de GIFs
# simplemente no devuelve resultados; nada más del backend depende de ella.
GIPHY_API_KEY=

# ---- Stockfish (partidas contra bot) ----
# Ruta del binario dentro del contenedor — con la imagen base Ubuntu Jammy (ver
# backend/Dockerfile), apt-get instala Stockfish en /usr/games/stockfish, la
# convención de Debian/Ubuntu para paquetes de la categoría "juegos". Confírmalo con
# tu propio build: el log de "docker compose up --build" muestra la ruta real justo
# después de "which stockfish" — si no coincide con esto, usa la que te salga a ti.
STOCKFISH_PATH=/usr/games/stockfish